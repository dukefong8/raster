;; Development launchers for the Valley voxel game (browser + desktop).
;;
;;   bb valley.web       Valley on WebGPU — shadow-cljs watch (blocks)
;;   bb valley.repl      shadow-cljs browser REPL for Valley (needs valley.web + Chrome)
;;   bb valley.jvm       Valley on JVM/Vulkan, macOS Apple Silicon (blocks)
;;   bb valley.wasm      Regenerate the browser wasm kernels + cljs shim
;;
;; Valley shares examples/valley/*.cljc; see examples/valley/README.md.
;; Web Valley runs in the browser (WebGPU + wasm); `valley.jvm` runs the same
;; shell on the desktop (Vulkan via MoltenVK on macOS).
{:paths ["examples"]
 :tasks
 {:init (do
          (require '[babashka.fs :as fs]
                   '[babashka.process :as p])
          (defn die! [& msg]
            (binding [*out* *err*] (apply println msg))
            (System/exit 1)))

  ;; ---- Valley (voxel world: browser WebGPU/wasm + desktop JVM/Vulkan) ---------
  valley.web
  {:doc "WebGPU dev server for Valley (shadow-cljs watch, hot reload).
         Blocks; http://localhost:8080/valley-walk.html
         Needs a one-time npm install in examples/asteroids/web;
         auto-runs valley.wasm if the kernels are missing.
         REPL: with this running and the page open in Chrome, run
         `bb valley.repl` (or: cd examples/asteroids/web &&
         npx shadow-cljs cljs-repl cvalley-walk) and eval —
         e.g. (js/document.getElementById \"game\")."
   :task (let [web "examples/asteroids/web"]
           (when-not (fs/exists? (fs/file web "node_modules"))
             (die! "node modules missing — run once:"
                   "(cd examples/asteroids/web && npm install)"))
           (when-not (fs/exists? (fs/file web "public" "valley_kernels.wasm"))
             (println "wasm kernels missing — generating first"
                      "(bb valley.wasm)…")
             (p/shell "clojure" "-Sdeps" "{:paths [\"src\" \"examples\"]}"
                      "-M" "examples/valley/gen.clj"))
           (println "▶ WebGPU dev server (hot reload):"
                    "http://localhost:8080/valley-walk.html")
           (println "  edits in examples/valley/*.cljc or"
                    "examples/asteroids/web/src push into the open page")
           (println "  REPL: open the page in Chrome, then in another terminal:"
                    "bb valley.repl")
           (let [{:keys [exit]} (p/shell {:continue true :dir web}
                                         "npx" "shadow-cljs" "watch"
                                         "cvalley-walk")]
             (System/exit exit)))}

  valley.repl
  {:doc "shadow-cljs browser REPL for Valley (evals in Chrome).
         Needs `bb valley.web` running and valley-walk.html open in Chrome.
         Try: (js/document.getElementById \"game\")."
   :task (let [web "examples/asteroids/web"]
           (when-not (fs/exists? (fs/file web "node_modules"))
             (die! "node modules missing — run once:"
                   "(cd examples/asteroids/web && npm install)"))
           (println "▶ Valley browser REPL (Chrome must have valley-walk.html open)")
           (let [{:keys [exit]} (p/shell {:continue true :dir web}
                                         "npx" "shadow-cljs" "cljs-repl"
                                         "cvalley-walk")]
             (System/exit exit)))}

  valley.jvm
  {:doc "Valley on JVM/Vulkan (macOS Apple Silicon; needs: brew install molten-vk).
         Blocks until the window closes."
   :task (do
           (println "▶ Valley (JVM/Vulkan) — close the window to stop")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure" "-M:vulkan:vulkan-macos-arm64"
                                         "-m" "valley.vk-walk")]
             (System/exit exit)))}

  valley.wasm
  {:doc "Regenerate the browser wasm kernels + cljs shim (one-shot).
         Writes examples/asteroids/web/public/valley_kernels.wasm and
         examples/asteroids/web/src/valley/kernels.cljs (gitignored)."
   :task (do
           (println "▶ regenerating valley wasm kernels into"
                    "examples/asteroids/web")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure" "-Sdeps" "{:paths [\"src\" \"examples\"]}"
                                         "-M" "examples/valley/gen.clj")]
             (System/exit exit)))}}}
